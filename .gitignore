/build/
/build-a100/
/build_opt/
/README_PARKED.md
/build_logs/
/build_t00/
/kokkos/
/setup.sh
*.cobaltlog
*.error
*.output
PLAN_*.md

# Claude Code session state, and -- the reason this entry earns its keep --
# git worktrees created under .claude/worktrees/. Those live INSIDE this
# checkout, so without this line a `git add -A` here sweeps an entire parallel
# working tree into a commit. Two sections of the core plan were developed
# concurrently that way, one per worktree.
.claude/

# Standalone host tools compiled by g++ directly into scripts/ (not via cmake).
scripts/gen_ff_constants
scripts/test_ffmul
scripts/attic/gen_qf_constants
scripts/attic/test_qfmul
scripts/attic/gen_corpus
scripts/sweep_accuracy

# Shared cross-backend validation corpus emitted by scripts/attic/gen_corpus
# (multi-GB at the default --n; the generator is committed, its output is not).
scripts/xp_corpus.bin

# Per-sub-plan validation scratch. These were captures taken to prove one
# restructure byte-identical, then never read again; the numbers of record are
# validation/sweep/ and docs/DOMAINS.md.
#
# /validation/a100/ WAS listed here, because S1's artifacts were pruned. S8b
# put a device-validation harness back in that directory -- run_a100.sh plus
# its logs, the same shape as validation/mi250/ -- and an ignore rule would
# have silently swallowed it. Removed deliberately; do not re-add.
/validation/s2/
/validation/s3/
/validation/s5/
/validation/s5p3/
/validation/s5p4/
/validation/s5p5/

# Uncompressed sweep baselines. The committed one is sweep_baseline.csv.gz;
# an 8.7 MB text copy next to it is how the two diverge.
/validation/sweep/sweep_baseline.csv
/validation/sweep/sweep_classified.csv
.run.log

# Cobalt's own job files. The blanket *.output / *.error / *.cobaltlog rules at
# the top of this file exist so a job submitted from the repo root leaves no
# droppings -- but the A100 job's .output IS the evidence, so the copies filed
# under validation/a100/logs/ are exempted.
!/validation/a100/logs/*.output
!/validation/a100/logs/*.error
!/validation/a100/logs/*.cobaltlog
!/validation/mi250/logs/*.output
!/validation/mi250/logs/*.error
!/validation/mi250/logs/*.cobaltlog

# Device-validation build products. validation/mi250/run_mi250.sh compiles on
# the compute node with --save-temps=obj, which drops ~25 MB of .bc/.hipi/.o/.s
# next to the binary. The LOGS under validation/mi250/logs/ are the artifact
# worth keeping; this is the intermediate. examples/cln_micro/build/ is what
# happens when a directory like this is not listed here.
/validation/*/work/
