# Standalone host tools compiled by g++ directly into scripts/ (not via cmake).
scripts/gen_ff_constants
scripts/test_ffmul
scripts/gen_qf_constants
scripts/test_qfmul
scripts/gen_corpus
scripts/sweep_accuracy

# Shared cross-backend validation corpus emitted by scripts/gen_corpus
# (multi-GB at the default --n; the generator is committed, its output is not).
scripts/xp_corpus.bin

# Per-sub-plan validation scratch. These were captures taken to prove one
# restructure byte-identical, then never read again; the numbers of record are
# validation/sweep/ and docs/DOMAINS.md.
/validation/a100/
/validation/s2/
/validation/s3/
/validation/s5/
/validation/s5p3/
/validation/s5p4/
/validation/s5p5/

# Uncompressed sweep baselines. The committed one is sweep_baseline.csv.gz;
# an 8.7 MB text copy next to it is how the two diverge.
/validation/sweep/sweep_baseline.csv
/validation/sweep/sweep_classified.csv
.run.log

# Device-validation build products. validation/mi250/run_mi250.sh compiles on
# the compute node with --save-temps=obj, which drops ~25 MB of .bc/.hipi/.o/.s
# next to the binary. The LOGS under validation/mi250/logs/ are the artifact
# worth keeping; this is the intermediate. examples/cln_micro/build/ is what
# happens when a directory like this is not listed here.
/validation/*/work/
